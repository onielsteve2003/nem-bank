# Copy to .env for local overrides; `task dev` and `task run` load it. Never commit .env.
APP_ENV=development
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
# Comma-separated exact origins. Defaults in development to the Expo web and console dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# Local docker-compose Postgres (`task db:up`). Required in production (Neon).
DATABASE_URL=postgres://nem:nem@localhost:5433/nem?sslmode=disable
DB_MAX_CONNS=10
MIGRATE_ON_START=true
# Header the host's proxy puts the caller's address in, for per-address rate limits.
# Empty = the TCP peer (right for local runs).
CLIENT_IP_HEADER=
# Observability (all optional, free tiers). Traces export only when the endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TRACE_SAMPLE_RATIO=1
SENTRY_DSN=
# Bearer token for /metrics. Required in production.
METRICS_TOKEN=
# Email (Brevo free tier). Empty = codes are logged, not sent. Required in production.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@nem.bank
MAIL_FROM_NAME=Nem Bank
# HMAC key for stored one-time codes: `openssl rand -base64 32`. Empty = a fixed dev key.
OTP_KEY=
# AES-256 field-encryption keys by version, highest encrypts: `1:$(openssl rand -base64 32)`.
FIELD_ENCRYPTION_KEYS=
# HMAC key for blind indexes (BVN uniqueness): `openssl rand -base64 32`.
FIELD_INDEX_KEY=
# Ed25519 seed that signs access tokens: `openssl rand -base64 32`. Empty = a fixed dev key.
JWT_SIGNING_KEY=
# A different Ed25519 seed for console (staff) tokens: `openssl rand -base64 32`.
STAFF_JWT_SIGNING_KEY=
# Interbank rail: sandbox_nip (simulated, default) or paystack_test (needs a test key).
BANK_PARTNER=sandbox_nip
# Fraud risk engine: enforce (stop flagged transfers), shadow (score and record only) or off.
RISK_MODE=enforce
# Paystack test secret key (sk_test_...). Live keys are refused.
PAYSTACK_SECRET_KEY=
# HMAC secret for sandbox rail callbacks: `openssl rand -base64 32`. Empty = a fixed dev key.
SANDBOX_NIP_WEBHOOK_SECRET=
# Where the sandbox calls back. Empty = this process over loopback.
SANDBOX_NIP_CALLBACK_URL=
