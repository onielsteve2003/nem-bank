# Copy to .env.local (gitignored) to override. Restart `pnpm dev` after changes.

# Where the app gets its data: `mock` (on-device mock bank, the default) or `http` (the Go API).
EXPO_PUBLIC_API_MODE=mock

# Base URL of the API. Required when EXPO_PUBLIC_API_MODE=http, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=
