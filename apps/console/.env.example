# Copy to .env.local (gitignored) to override. Restart `pnpm console` after changes.

# Where the console gets its data: `mock` (in-browser mock bank, the default) or `http` (the Go API).
VITE_API_MODE=mock

# Origin of the API. Required when VITE_API_MODE=http, e.g. http://localhost:8080
# The API's CORS_ALLOWED_ORIGINS must list the console's origin (http://localhost:5173 in dev).
VITE_API_URL=
